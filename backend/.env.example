# Postgres (docker compose up -d db). Defaults to a local SQLite file when unset.
MINEBET_DATABASE_URL=postgresql+asyncpg://minebet:minebet@localhost:5432/minebet
# Use a long random value in any shared environment.
MINEBET_JWT_SECRET=change-me-to-a-long-random-string-of-32+-bytes
MINEBET_PAYMENTS_STUB=true
